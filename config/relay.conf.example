# Arguments for rtk_base_relay (python3 -m rtk_base.tools.relay @FILE), one
# option per line; lines starting with # are skipped.
--device=/dev/serial/by-id/usb-u-blox_AG_-_www.u-blox.com_u-blox_GNSS_receiver-if00
--baud=115200
--output=tcpserver://0.0.0.0:2101
# UDP broadcast on the local network, use the broadcast address of that network
#--output=udp://<broadcast address>:2101
--status-period=60
# UM982: configure base mode on every connect (omit these for a receiver set up with its own tools)
#--receiver=unicore
#--survey-s=120
#--fixed-position <lat_deg> <lon_deg> <height_m>
#--rtcm-message=1006:10
#--rtcm-message=1074:1
