# RTCM relay for a base station computer without ROS.
#
# Install from the repository folder (README, Station files):
#   cp systemd/rtk_base_relay.service site/
#   (edit User and the two paths in site/rtk_base_relay.service)
#   sudo systemctl enable --now $PWD/site/rtk_base_relay.service
# Logs:
#   journalctl -u rtk_base_relay -f

[Unit]
Description=RTCM relay (rtk_base)
After=network-online.target
Wants=network-online.target

[Service]
User=CHANGE_ME_USER
WorkingDirectory=/home/CHANGE_ME_USER/rtk_base
ExecStart=/usr/bin/python3 -m rtk_base.tools.relay @/home/CHANGE_ME_USER/rtk_base/site/relay.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
